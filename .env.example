# Local-only portfolio project -- these are working LOCAL values, not
# production secrets. Copy this file to `.env` and adjust ports if they
# collide with something already running on your machine.

# --- Database ---
DB_HOST=db
DB_PORT=3307
DB_NAME=filas
DB_USER=filas
DB_PASSWORD=filas_local_dev
DB_ROOT_PASSWORD=root_local_dev

# --- API ---
API_PORT=8080
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRY_HOURS=3
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (used by later PRs) ---
WEB_PORT=8081
VITE_API_URL=http://localhost:8080
